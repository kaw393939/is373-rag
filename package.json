{
  "name": "is373-rag",
  "version": "0.1.0",
  "private": true,
  "description": "Code-grounded Ordo reuse roadmap, twelve-factor design and executable documentation.",
  "type": "module",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vitepress dev docs --host 127.0.0.1",
    "build": "vitepress build docs",
    "preview": "vitepress preview docs --host 127.0.0.1",
    "check:plan": "node scripts/check-plan.mjs",
    "check:pages": "node scripts/check-pages.mjs",
    "check:ia": "node scripts/check-ia.mjs",
    "test:examples": "node --test docs/examples/stream.test.mjs && python3 docs/examples/publication.py",
    "test": "npm run check:plan && npm run test:examples && npm run build && npm run check:pages && npm run check:ia"
  },
  "devDependencies": {
    "debug": "^4.4.0",
    "vitepress": "1.6.4",
    "vitepress-plugin-mermaid": "2.0.17",
    "mermaid": "^11.0.0",
    "vue": "^3.5.0"
  },
  "overrides": { "vite": "6.4.5", "katex": "0.18.2" }
}
